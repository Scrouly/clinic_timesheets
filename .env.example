# Скопируйте в .env и поправьте значения. Файл .env в git не попадает.

# Какие настройки использовать: config.settings.dev или config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Обязателен в prod. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Для разработки можно оставить пустым: тогда будет файл db.sqlite3.
# PostgreSQL:  postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@СЕРВЕР:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=

# Только для prod: список адресов через запятую
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1, когда сайт работает по HTTPS (включает защищённые cookie и редирект)
DJANGO_HTTPS=0

# Название в шапке и заголовках страниц
APP_TITLE=График работы врачей
ORG_NAME=

# Сколько часов живёт вход в систему
SESSION_HOURS=10
